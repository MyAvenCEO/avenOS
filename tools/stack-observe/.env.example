# Copy to .env.next or .env.production, use absolute paths, then chmod 600.
SSH_HOST=id.next.aven.ceo
SSH_PORT=22
SSH_USER=aven-deploy
SSH_IDENTITY_FILE=/absolute/path/to/aven-identity-next-deploy-key
SSH_KNOWN_HOSTS_FILE=/absolute/path/to/aven-identity-next-known-hosts

PUBLIC_BASE_URL=https://id.next.aven.ceo
