# Copy to .env.next and run: chmod 600 .env.next

SSH_HOST=id.next.aven.ceo
SSH_PORT=22
SSH_USER=aven-db-operator
SSH_IDENTITY_FILE=/absolute/path/to/aven-identity-next-operator
SSH_KNOWN_HOSTS_FILE=/absolute/path/to/aven-identity-next-known-hosts

# The database is published only on the remote host's loopback interface.
LOCAL_DB_PORT=55433
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=55432

# Used by --psql and as connection information for local database clients.
PGDATABASE=aven
PGUSER=aven_operator
PGPASSWORD=
