node_modules

# Local second brain vault + upstream mirrors (never commit)
/.data/
/libs/aven-website/.data/
/.repos/

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/ARCHIVE/*/.svelte-kit
/app/.svelte-kit
/libs/aven-website/.svelte-kit
/build
/ARCHIVE/*/build
/app/build
/services/aven-api/email-templates/.maizzle/
/services/aven-api/email-templates/.maizzle-dist/

# OS
.DS_Store
Thumbs.db

# Local editor and agent state
**/.idea/
/.agent-state/

# Env
.env
.env.*
!.env.example

# Pulumi DIY-backend state and environment-specific stack configuration
**/.pulumi/
/infrastructure/**/Pulumi.*.yaml

# One-time identity deployment trust bootstrap files
/aven-identity-next-deploy
/aven-identity-next-deploy.pub
/aven-identity-next-known-hosts

# Jaensen local SQLite (do not commit)
/.jaensen/state.db
/.jaensen/state.db-*

# Python
__pycache__/
*.py[cod]
*.pyo

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Vibe app sandbox + mini-app build outputs (rebuilt by `bun run build` per package).
/libs/aven-vibe-sandbox/sandbox/dist/
/libs/aven-vibes/*/dist/
/libs/aven-website/build/

# Upstream jazz2 mirror (local refresh only — never commit)
/tools/jazz2-upstream/
# Ephemeral overlay stash for scripts/revendor-aven-db.sh
/.avenos-revendor-backup/
target/
**/target/

# App Store / local packaging outputs (never commit)
/dist/
**/*.pkg

# Repo-local P2p signal relay keys (relay-hyperdht.seed, bootstrap-hyperdht.seed)
/.avenOS/
**/.avenOS/

# Provisioned onnxruntime dylib for the on-device LLM (`ort` load-dynamic).
# Fetched by scripts/fetch-onnxruntime.ts (matches the version ort targets); a
# ~35MB binary — not committed, re-downloaded on demand / at packaging.
/app/src-tauri/onnxruntime/

# video-edit skill: generated / large media — re-render (render.sh) or re-fetch
# (fetch_stock.py / tts_synth) locally; never commit the binaries.
/app/static/skills/editing/*.mp4
/app/static/skills/editing/*.wav
.claude/skills/video-edit/examples/**/assets/
# Ephemeral Claude Code dev artifacts
/.claude/scheduled_tasks.lock

# Local dev preview config (machine-specific absolute paths)
/.claude/launch.json

ARCHIVE/tauri-plugin-passkey/swift-lib/.build/

# SwiftPM output from building the iOS passkey plugin: the Tauri API copy is
# generated by the plugin's build script, and Package.resolved pins a checkout
# that every build re-resolves.
libs/tauri-plugin-ios-passkey/.tauri/
libs/tauri-plugin-ios-passkey/ios/Package.resolved

# aven-git dev instance: the headless Gitea's whole state (SQLite, repos,
# token, logs) — disposable, never committed.
libs/aven-git/.gitea-dev/
