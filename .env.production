# Production build config (NON-SECRET). Loaded by `vite build` (production mode) only —
# `vite dev` ignores it, so local dev still uses the launcher's localhost auth URL.
#
# PUBLIC_* vars are baked into the web bundle (envPrefix in app/vite.config.ts). This points
# every production build (local `release:app:*` AND CI) at the deployed next auth API, so a
# build that forgets to export PUBLIC_BETTER_AUTH_URL no longer falls back to the app's own
# origin (which caused "Load failed" on sign-in). CI sets the same value explicitly, which
# takes precedence. board 0050.
PUBLIC_BETTER_AUTH_URL=https://api.next.aven.ceo
