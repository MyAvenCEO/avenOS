NODE_ENV=development
LOG_LEVEL=info
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
DOCKER_LOG_COMPRESS=true
PUBLIC_BASE_URL=http://localhost:5173
ORIGIN=http://localhost:5173
DOWNLOAD_URL=https://github.com/MyAvenCEO/avenOS/releases
IDENTITY_ISSUER=http://localhost:3100
IDENTITY_JWKS_URL=http://localhost:3100/api/auth/jwks
IDENTITY_INTERNAL_URL=http://localhost:3100
IDENTITY_AUDIENCE=aven-services
IDENTITY_PROVISIONING_SECRET=replace-with-at-least-32-random-characters

DATABASE_URL=postgres://aven_server:server-dev@127.0.0.1:55432/aven
MIGRATOR_DATABASE_URL=postgres://aven_migrator:migrator-dev@127.0.0.1:55432/aven
EMAIL_WORKER_DATABASE_URL=postgres://aven_email_worker:email-dev@127.0.0.1:55432/aven
ENVIRONMENT_WORKER_DATABASE_URL=postgres://aven_environment_worker:environment-dev@127.0.0.1:55432/aven
PROVISIONER_DATABASE_URL=postgres://aven_provisioner:provisioner-dev@127.0.0.1:55432/postgres

# Local Artifact Store Compose overlay. The service routes to one schema in each
# provisioned customer database; cust_artifact_local is only the direct smoke target.
ARTIFACT_STORE_BIND=127.0.0.1
ARTIFACT_STORE_PORT=8087
ARTIFACT_STORE_DATABASE_NAME=cust_artifact_local
ARTIFACT_STORE_SCOPE_ID=11111111-1111-4111-8111-111111111111
ARTIFACT_STORE_BEARER_TOKEN=artifact-local-coordinator-token-0001
ARTIFACT_STORE_PROVISIONER_BEARER_TOKEN=artifact-local-provisioner-token-0001
ARTIFACT_STORE_RUNTIME_PASSWORD=artifact-local-runtime-password-0001
ARTIFACT_STORE_MAX_TENANT_POOLS=64
ARTIFACT_STORE_CONNECTIONS_PER_TENANT=2
ARTIFACT_STORE_MEMORY_LIMIT=512m
ARTIFACT_STORE_MAX_UPLOAD_BYTES=26214400
ARTIFACT_STORE_MAX_CONCURRENT_UPLOADS=2
ARTIFACT_STORE_MAX_LIVE_CLAIMS_PER_SCOPE=32
ARTIFACT_STORE_MAX_STAGED_BYTES_PER_SCOPE=104857600
ARTIFACT_STORE_MAX_LOGICAL_BYTES_PER_SCOPE=1073741824
ARTIFACT_STORE_PUBLISHER_ISSUER=aven-api
ARTIFACT_STORE_PUBLISHER_SUBJECT=artifact-coordinator
ARTIFACT_STORE_LOG=aven_artifact_store=info,tower_http=info

EMAIL_QUEUE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM="Aven <no-reply@aven.local>"

NAME_PRICE_EUR=25
NAME_HOLD_TTL_HOURS=24
NAME_RESERVATION_TTL_MINUTES=5
# Polar (https://polar.sh) — the payment provider. Leave the key empty for the
# local FakePaymentProvider. Products are synced by metadata.tier from the
# pricing SSOT (@myavenceo/aven-ceo/pricing) — no pinned product ids.
POLAR_API_KEY=
# sandbox | production — sandbox and production are fully separate orgs/tokens
POLAR_SERVER=sandbox
# optional sanity anchor; the org token already scopes every call
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=dev-fake-webhook-secret
AVEN_TIER_NAME=
