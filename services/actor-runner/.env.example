PORT=3010
IDENTITY_ISSUER=https://aven.id
# Optional internal route to the same issuer's public keys.
# IDENTITY_JWKS_URL=http://identity:3000/api/auth/jwks
IDENTITY_AUDIENCE=aven-services
ACTOR_RUNNER_SERVICE_BEARER_TOKEN=replace-with-at-least-32-random-bytes
TENANT_GRANT_ISSUER=https://api.aven.ceo
TENANT_GRANT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
CUSTOMER_DATABASE_HOST=127.0.0.1
CUSTOMER_DATABASE_PORT=5432
CUSTOMER_DATABASE_SSL=false
# These roots derive separate per-customer API and worker database credentials.
ACTOR_API_DB_CREDENTIAL_ROOT=replace-with-at-least-32-random-bytes
ACTOR_WORKER_DB_CREDENTIAL_ROOT=replace-with-another-32-random-bytes
ARTIFACT_STORE_BASE_URL=http://127.0.0.1:8087
# Use the actor-runner credential, not the facade/API Artifact Store credential.
ARTIFACT_STORE_BEARER_TOKEN=replace-with-a-distinct-32-byte-runner-token
LLM_GATEWAY_BASE_URL=http://localhost:3000/internal/v1/llm
LLM_GATEWAY_BEARER_TOKEN=replace-with-a-distinct-32-byte-llm-token
