{
  "typeKey": "studio.understanding",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourceArtifactId",
      "status",
      "summary",
      "artifactIds",
      "warnings"
    ],
    "properties": {
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "status": {
        "enum": [
          "complete",
          "partial"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "artifactIds": {
        "type": "array",
        "maxItems": 1024,
        "items": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      },
      "warnings": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": [
    {
      "role": "result",
      "minimum": 0,
      "maximum": 1024,
      "allowedTargetTypes": {
        "kind": "any"
      },
      "attributesSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    }
  ]
}
