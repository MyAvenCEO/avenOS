{
  "typeKey": "studio.subscription",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "subscriptionId",
      "name",
      "skillArtifactId",
      "sourceArtifactId",
      "inputType",
      "inputPort",
      "fixedInputs",
      "generation"
    ],
    "properties": {
      "subscriptionId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "skillArtifactId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "sourceArtifactId": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 64
      },
      "inputType": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "version"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      },
      "inputPort": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "fixedInputs": {
        "type": "object",
        "maxProperties": 16,
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      },
      "generation": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": [
    {
      "role": "skill",
      "minimum": 0,
      "maximum": 1,
      "allowedTargetTypes": {
        "kind": "exact",
        "types": [
          {
            "typeKey": "studio.skill",
            "version": 1
          }
        ]
      },
      "attributesSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    }
  ]
}
