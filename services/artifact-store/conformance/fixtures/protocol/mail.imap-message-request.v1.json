{
  "typeKey": "mail.imap-message-request",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "bindingRef": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "accountRef": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "mailbox": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uidValidity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295
      },
      "uid": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295
      },
      "purpose": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maximumBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 33554432
      },
      "selection": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "artifactDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactId",
          "artifactDigest"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "bindingRef",
      "accountRef",
      "mailbox",
      "uidValidity",
      "uid",
      "purpose",
      "maximumBytes",
      "selection"
    ],
    "additionalProperties": false
  },
  "blobPolicy": "forbidden",
  "referenceRules": [
    {
      "role": "selection",
      "minimum": 1,
      "maximum": 1,
      "allowedTargetTypes": {
        "kind": "exact",
        "types": [
          {
            "typeKey": "mail.imap-query-result",
            "version": 1
          }
        ]
      },
      "attributesSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    }
  ]
}
