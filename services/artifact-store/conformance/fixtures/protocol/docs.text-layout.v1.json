{
  "typeKey": "docs.text-layout",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["coordinateSpace", "spans", "complete"],
    "properties": {
      "coordinateSpace": { "const": "normalized-millionths" },
      "complete": { "type": "boolean" },
      "spans": {
        "type": "array",
        "maxItems": 512,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "endExclusive", "page", "x", "y", "width", "height"],
          "properties": {
            "start": { "type": "integer", "minimum": 0, "maximum": 2000000 },
            "endExclusive": { "type": "integer", "minimum": 0, "maximum": 2000000 },
            "page": { "type": "integer", "minimum": 1, "maximum": 256 },
            "x": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "y": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "width": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "height": { "type": "integer", "minimum": 0, "maximum": 1000000 }
          }
        }
      }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
