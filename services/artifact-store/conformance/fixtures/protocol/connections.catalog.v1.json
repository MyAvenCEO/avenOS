{
  "typeKey": "connections.catalog",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "observedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
      },
      "bindings": {
        "maxItems": 256,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "bindingRef": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "protocol": {
              "type": "string",
              "enum": [
                "http",
                "imap"
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "hostMatch": {
              "type": "string",
              "enum": [
                "exact",
                "suffix"
              ]
            },
            "ports": {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "mailboxes": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "methods": {
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "GET",
                  "HEAD"
                ]
              }
            },
            "pathPrefix": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "bindingRef",
            "label",
            "protocol",
            "purpose",
            "enabled",
            "host",
            "hostMatch",
            "ports",
            "mailboxes",
            "methods",
            "pathPrefix"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "observedAt",
      "bindings"
    ],
    "additionalProperties": false
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
