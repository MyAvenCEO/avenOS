{
  "typeKey": "studio.email",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourceArtifactId",
      "occurrenceId",
      "subject",
      "from",
      "receivedAt"
    ],
    "properties": {
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "occurrenceId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "subject": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "from": {
        "type": "string",
        "minLength": 1,
        "maxLength": 320
      },
      "receivedAt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "blobPolicy": "required",
  "referenceRules": [
    {
      "role": "attachment",
      "minimum": 0,
      "maximum": 16,
      "allowedTargetTypes": {
        "kind": "exact",
        "types": [
          {
            "typeKey": "core.file",
            "version": 1
          }
        ]
      },
      "attributesSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    }
  ]
}
