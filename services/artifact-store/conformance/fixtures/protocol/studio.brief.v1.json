{
  "typeKey": "studio.brief",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourceArtifactId",
      "title",
      "summary",
      "status"
    ],
    "properties": {
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "status": {
        "enum": [
          "complete",
          "partial"
        ]
      }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
