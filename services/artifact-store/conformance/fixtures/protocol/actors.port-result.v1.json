{
  "typeKey": "actors.port-result",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["invocationId", "port", "cardinality", "members"],
    "properties": {
      "invocationId": { "type": "string", "minLength": 1, "maxLength": 160 },
      "port": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
      "cardinality": { "enum": ["one", "optional", "many"] },
      "members": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memberKey", "referenceOrdinal"],
          "properties": {
            "memberKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
            "referenceOrdinal": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": [
    {
      "role": "member",
      "minimum": 0,
      "maximum": 256,
      "allowedTargetTypes": { "kind": "any" },
      "attributesSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    }
  ]
}
