{
  "typeKey": "mail.imap-query",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "bindingRef": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "mailbox": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "purpose": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "criteria": {
        "default": {
          "seen": "any"
        },
        "type": "object",
        "properties": {
          "internalDate": {
            "type": "object",
            "properties": {
              "since": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "before": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "additionalProperties": false
          },
          "fromContains": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "subjectContains": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "seen": {
            "default": "any",
            "type": "string",
            "enum": [
              "any",
              "seen",
              "unseen"
            ]
          }
        },
        "additionalProperties": false
      },
      "metadata": {
        "default": [
          "internal-date",
          "size"
        ],
        "minItems": 1,
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "internal-date",
            "size",
            "flags"
          ]
        }
      },
      "order": {
        "default": "uid-ascending",
        "type": "string",
        "const": "uid-ascending"
      },
      "limits": {
        "default": {
          "maximumMatches": 100,
          "maximumCommands": 20,
          "maximumSeconds": 30,
          "maximumResultBytes": 262144
        },
        "type": "object",
        "properties": {
          "maximumMatches": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "maximumCommands": {
            "default": 20,
            "type": "integer",
            "minimum": 4,
            "maximum": 128
          },
          "maximumSeconds": {
            "default": 30,
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "maximumResultBytes": {
            "default": 262144,
            "type": "integer",
            "minimum": 1024,
            "maximum": 1048576
          }
        },
        "additionalProperties": false
      },
      "continuation": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "artifactDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactId",
          "artifactDigest"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "bindingRef",
      "mailbox",
      "purpose"
    ],
    "additionalProperties": false
  },
  "blobPolicy": "forbidden",
  "referenceRules": [
    {
      "role": "continuation",
      "minimum": 0,
      "maximum": 1,
      "allowedTargetTypes": {
        "kind": "exact",
        "types": [
          {
            "typeKey": "mail.imap-query-result",
            "version": 1
          }
        ]
      },
      "attributesSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    }
  ]
}
