{
  "typeKey": "core.bundle",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["purpose"],
    "properties": {
      "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
      "displayName": { "type": ["string", "null"], "maxLength": 255 }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": [
    {
      "role": "member",
      "minimum": 1,
      "maximum": 64,
      "allowedTargetTypes": { "kind": "any" },
      "attributesSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "label": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    }
  ]
}
