{
  "typeKey": "bookkeeping.invoice-candidate",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["supplier", "invoiceNumber", "currency", "netMinor", "taxMinor", "grossMinor", "dueDate", "summary"],
    "properties": {
      "supplier": { "type": "string", "minLength": 1, "maxLength": 255 },
      "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 128 },
      "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
      "netMinor": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
      "taxMinor": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
      "grossMinor": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
      "dueDate": { "type": ["string", "null"], "maxLength": 32 },
      "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
