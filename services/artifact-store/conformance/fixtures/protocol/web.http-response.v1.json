{
  "typeKey": "web.http-response",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "requestedUrl": {
        "type": "string",
        "maxLength": 8192
      },
      "finalUrl": {
        "type": "string",
        "maxLength": 8192
      },
      "statusCode": {
        "type": "integer",
        "minimum": 200,
        "maximum": 599
      },
      "networkStatusCode": {
        "type": "integer",
        "minimum": 200,
        "maximum": 599
      },
      "cacheDisposition": {
        "type": "string",
        "enum": [
          "new",
          "revalidated"
        ]
      },
      "representationSourceArtifactId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "protocol": {
        "type": "string",
        "maxLength": 32
      },
      "declaredMediaType": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 256
          },
          {
            "type": "null"
          }
        ]
      },
      "declaredCharset": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 128
          },
          {
            "type": "null"
          }
        ]
      },
      "etag": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 16384
          },
          {
            "type": "null"
          }
        ]
      },
      "lastModified": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 16384
          },
          {
            "type": "null"
          }
        ]
      },
      "headers": {
        "maxItems": 8,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "cache-control",
                "content-disposition",
                "content-type",
                "date",
                "etag",
                "expires",
                "last-modified",
                "vary"
              ]
            },
            "values": {
              "minItems": 1,
              "maxItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 16384
              }
            }
          },
          "required": [
            "name",
            "values"
          ],
          "additionalProperties": false
        }
      },
      "redirectCount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "redirectStoppedReason": {
        "type": "string",
        "enum": [
          "manual",
          "missing-location",
          "cross-origin-authentication"
        ]
      },
      "storedBodyLength": {
        "type": "integer",
        "minimum": 0,
        "maximum": 33554432
      },
      "capturedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
      }
    },
    "required": [
      "requestedUrl",
      "finalUrl",
      "statusCode",
      "cacheDisposition",
      "declaredMediaType",
      "declaredCharset",
      "etag",
      "lastModified",
      "headers",
      "redirectCount",
      "storedBodyLength",
      "capturedAt"
    ],
    "additionalProperties": false
  },
  "blobPolicy": "required",
  "referenceRules": []
}
