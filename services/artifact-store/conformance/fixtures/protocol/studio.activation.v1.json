{
  "typeKey": "studio.activation",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "activationId",
      "skillArtifactId",
      "inputs",
      "initiator",
      "origin",
      "subscriptionArtifactId"
    ],
    "properties": {
      "activationId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "skillArtifactId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "inputs": {
        "type": "object",
        "maxProperties": 16,
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      },
      "initiator": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "origin": {
        "enum": [
          "manual",
          "subscription"
        ]
      },
      "subscriptionArtifactId": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 64
      }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
