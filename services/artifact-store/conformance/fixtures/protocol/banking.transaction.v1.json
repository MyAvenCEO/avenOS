{
  "typeKey": "banking.transaction",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["dedupKey", "dedupBasis", "accountRef", "providerTransactionId", "bookingDate", "valueDate", "title", "amountMinor", "currency", "counterpartyName", "counterpartyIban", "description", "originalAmountMinor", "originalCurrency", "exchangeRate", "fxSurchargeMinor", "foreignExchangeFeeBps", "balanceAfterMinor", "sourceRow", "sourceOrdinal", "statementValidationStatus", "statementCoverage"],
    "properties": {
      "dedupKey": { "type": "string", "minLength": 1, "maxLength": 512 },
      "dedupBasis": { "enum": ["provider-id", "fingerprint"] },
      "accountRef": { "type": "string", "minLength": 1, "maxLength": 255 },
      "providerTransactionId": { "type": ["string", "null"], "maxLength": 255 },
      "bookingDate": { "type": ["string", "null"], "maxLength": 32 },
      "valueDate": { "type": ["string", "null"], "maxLength": 32 },
      "title": { "type": ["string", "null"], "maxLength": 512 },
      "amountMinor": { "$ref": "#/$defs/money" },
      "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
      "counterpartyName": { "type": ["string", "null"], "maxLength": 512 },
      "counterpartyIban": { "type": ["string", "null"], "maxLength": 64 },
      "description": { "type": ["string", "null"], "maxLength": 4000 },
      "originalAmountMinor": { "$ref": "#/$defs/money" },
      "originalCurrency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
      "exchangeRate": { "type": ["string", "null"], "maxLength": 64 },
      "fxSurchargeMinor": { "$ref": "#/$defs/money" },
      "foreignExchangeFeeBps": { "type": ["integer", "null"], "minimum": -100000, "maximum": 100000 },
      "balanceAfterMinor": { "$ref": "#/$defs/money" },
      "sourceRow": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000000 },
      "sourceOrdinal": { "type": "integer", "minimum": 0, "maximum": 127 },
      "statementValidationStatus": { "enum": ["consistent", "inconsistent", "incomplete", "insufficient-coverage"] },
      "statementCoverage": { "enum": ["verified", "unverified", "row-limit-reached"] }
    },
    "$defs": {
      "money": { "type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991 }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
