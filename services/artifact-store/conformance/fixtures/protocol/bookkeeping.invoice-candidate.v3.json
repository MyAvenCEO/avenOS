{
  "typeKey": "bookkeeping.invoice-candidate",
  "version": 3,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "supplier",
      "invoiceNumber",
      "currency",
      "netMinor",
      "taxMinor",
      "grossMinor",
      "dueDate",
      "summary"
    ],
    "properties": {
      "supplier": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 255
      },
      "invoiceNumber": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 128
      },
      "currency": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[A-Z]{3}$"
      },
      "netMinor": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "taxMinor": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "grossMinor": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "dueDate": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 32
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "chunkCoverage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "completed",
          "complete",
          "conflicts"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "completed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "complete": {
            "type": "boolean"
          },
          "conflicts": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
