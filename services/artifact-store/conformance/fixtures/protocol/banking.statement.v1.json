{
  "typeKey": "banking.statement",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["statementKind", "accountRef", "accountIdentityBasis", "currency", "accountHolder", "institutionName", "periodStart", "periodEnd", "openingBalanceMinor", "closingBalanceMinor", "transactionCount", "validationStatus", "coverage", "summary"],
    "properties": {
      "statementKind": { "type": "string", "minLength": 1, "maxLength": 64 },
      "accountRef": { "type": "string", "minLength": 1, "maxLength": 255 },
      "accountIdentityBasis": { "enum": ["iban", "account-number", "derived"] },
      "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
      "accountHolder": { "type": ["string", "null"], "maxLength": 255 },
      "institutionName": { "type": ["string", "null"], "maxLength": 255 },
      "periodStart": { "type": ["string", "null"], "maxLength": 32 },
      "periodEnd": { "type": ["string", "null"], "maxLength": 32 },
      "openingBalanceMinor": { "$ref": "#/$defs/money" },
      "closingBalanceMinor": { "$ref": "#/$defs/money" },
      "transactionCount": { "type": "integer", "minimum": 0, "maximum": 128 },
      "validationStatus": { "enum": ["consistent", "inconsistent", "incomplete", "insufficient-coverage"] },
      "coverage": { "enum": ["verified", "unverified", "row-limit-reached"] },
      "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "$defs": {
      "money": { "type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991 }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
