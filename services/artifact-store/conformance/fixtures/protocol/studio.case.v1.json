{
  "typeKey": "studio.case", "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object", "additionalProperties": false,
    "required": ["case", "status", "predecessorArtifactId", "recordedBy"],
    "properties": {
      "case": { "type": "object", "additionalProperties": false,
        "required": ["title", "situation", "outcome", "evidence", "steps", "uncertainties"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "situation": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "outcome": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object" } },
          "steps": { "type": "array", "maxItems": 32, "items": { "type": "object" } },
          "uncertainties": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 2000 } }
        }
      },
      "status": { "enum": ["proposed", "confirmed"] },
      "predecessorArtifactId": { "type": ["string", "null"] },
      "recordedBy": { "type": "string" }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": [
    { "role": "predecessor", "minimum": 0, "maximum": 1,
      "allowedTargetTypes": { "kind": "exact", "types": [{ "typeKey": "studio.case", "version": 1 }] },
      "attributesSchema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} } },
    { "role": "evidence", "minimum": 0, "maximum": 32,
      "allowedTargetTypes": { "kind": "any" },
      "attributesSchema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} } }
  ]
}
