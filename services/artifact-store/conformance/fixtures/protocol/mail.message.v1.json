{
  "typeKey": "mail.message",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "mediaType": {
        "type": "string",
        "const": "message/rfc822"
      },
      "byteLength": {
        "type": "integer",
        "minimum": 0,
        "maximum": 33554432
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "mediaType",
      "byteLength",
      "sha256"
    ],
    "additionalProperties": false
  },
  "blobPolicy": "required",
  "referenceRules": []
}
