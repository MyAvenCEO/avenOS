{
  "typeKey": "core.file-inspection",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["outcome", "detectedMediaType", "readable", "pageCount", "encrypted"],
    "properties": {
      "outcome": { "enum": ["ok", "malformed", "encrypted", "unsupported"] },
      "detectedMediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
      "readable": { "type": "boolean" },
      "pageCount": { "type": "integer", "minimum": 0, "maximum": 256 },
      "encrypted": { "type": "boolean" }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
