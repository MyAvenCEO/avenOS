{
  "typeKey": "core.content-classification",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["subjectLevel", "primaryKind", "facets", "confidenceBps", "reason", "resolutionMode", "complete"],
    "properties": {
      "subjectLevel": { "enum": ["file", "page"] },
      "primaryKind": { "enum": ["document", "image", "text", "structured-data", "mixed", "blank", "other", "unknown"] },
      "facets": {
        "type": "array",
        "maxItems": 16,
        "uniqueItems": true,
        "items": { "enum": ["native-text", "raster-text", "handwriting", "photograph", "illustration", "diagram", "chart", "table"] }
      },
      "confidenceBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
      "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "resolutionMode": { "enum": ["model", "rule", "human", "fallback"] },
      "complete": { "type": "boolean" }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
