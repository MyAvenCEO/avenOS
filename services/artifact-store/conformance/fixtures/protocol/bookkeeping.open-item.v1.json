{
  "typeKey": "bookkeeping.open-item",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["businessKey", "businessKeyBasis", "documentKind", "direction", "supplierName", "supplierIbans", "invoiceNumber", "orderNumber", "issueDate", "dueDate", "currency", "grossMinor", "amountDueMinor", "amountPaidMinor", "references", "validationStatus", "summary"],
    "properties": {
      "businessKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "businessKeyBasis": { "enum": ["supplier-invoice-number", "document-fallback"] },
      "documentKind": { "type": "string", "minLength": 1, "maxLength": 64 },
      "direction": { "enum": ["payable", "receivable", "unknown"] },
      "supplierName": { "type": "string", "minLength": 1, "maxLength": 255 },
      "supplierIbans": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
      "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 128 },
      "orderNumber": { "type": ["string", "null"], "maxLength": 128 },
      "issueDate": { "type": ["string", "null"], "maxLength": 32 },
      "dueDate": { "type": ["string", "null"], "maxLength": 32 },
      "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
      "grossMinor": { "$ref": "#/$defs/money" },
      "amountDueMinor": { "$ref": "#/$defs/money" },
      "amountPaidMinor": { "$ref": "#/$defs/nullableMoney" },
      "references": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
      "validationStatus": { "enum": ["consistent", "inconsistent", "incomplete", "insufficient-coverage"] },
      "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "$defs": {
      "money": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
      "nullableMoney": { "type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991 }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
