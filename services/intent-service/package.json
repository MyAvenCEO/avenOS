		"jose": "6.2.9",
		"pg": "8.16.3",
		"pino": "10.3.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/bun": "1.3.13",
		"@types/node": "24.10.13",
		"@types/pg": "8.15.6",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
