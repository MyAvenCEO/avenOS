NODE_ENV=development
LOG_LEVEL=info
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
DOCKER_LOG_COMPRESS=true
PUBLIC_BASE_URL=http://localhost:5173
WEBAUTHN_RP_ID=localhost
ORIGIN=http://localhost:5173
DOWNLOAD_URL=https://github.com/MyAvenCEO/avenOS/releases
REQUIRE_PASSKEY_PRF=false

DATABASE_URL=postgres://aven_server:server-dev@127.0.0.1:55432/aven
MIGRATOR_DATABASE_URL=postgres://aven_migrator:migrator-dev@127.0.0.1:55432/aven
EMAIL_WORKER_DATABASE_URL=postgres://aven_email_worker:email-dev@127.0.0.1:55432/aven
ENVIRONMENT_WORKER_DATABASE_URL=postgres://aven_environment_worker:environment-dev@127.0.0.1:55432/aven
PROVISIONER_DATABASE_URL=postgres://aven_provisioner:provisioner-dev@127.0.0.1:55432/postgres

BETTER_AUTH_SECRET=change-me-to-a-long-random-string-please
EMAIL_QUEUE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM="Aven <no-reply@aven.local>"

NAME_PRICE_EUR=25
NAME_HOLD_TTL_HOURS=24
NAME_RESERVATION_TTL_MINUTES=5
CREEM_API_KEY=
# avenID (one-time) — required whenever CREEM_API_KEY is set
CREEM_PRODUCT_ID=
# avenME / avenFOUNDER subscriptions — pinned ids win; left empty, the seeder adopts
# products by NAME or creates them from the pricing SSOT (price is not updated on adopt)
CREEM_PRODUCT_AVENME=
CREEM_PRODUCT_AVENCEO=
CREEM_WEBHOOK_SECRET=dev-fake-webhook-secret
