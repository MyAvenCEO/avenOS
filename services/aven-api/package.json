{
	"name": "@avenos/aven-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:designer": "vite dev --mode designer",
		"build": "svelte-kit sync && bun run email:check && vite build",
		"build:designer": "vite build --mode designer",
		"preview": "vite preview",
		"preview:designer": "vite build --mode designer && vite preview --mode designer",
		"start": "bun build/index.js",
		"email:studio": "bun tools/email/studio.ts",
		"email:preview": "maizzle serve",
		"email:compile": "bun tools/email/build.ts",
		"email:check": "bun tools/email/check.ts",
		"worker:email": "bun scripts/email-worker.ts",
		"worker:environment": "bun scripts/environment-worker.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "svelte-kit sync && bun run email:check && vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"environment:status": "bun scripts/environment.ts status",
		"environment:retry": "bun scripts/environment.ts retry",
		"environment:reconcile": "bun scripts/environment.ts reconcile",
		"db:seed:billing": "bun scripts/seed-billing.ts",
		"artifact-store:smoke": "bun scripts/artifact-store-smoke.ts",
		"artifact-processing:smoke": "bun scripts/artifact-processing-smoke.ts",
		"persistent-intent:smoke": "bun scripts/artifact-processing-smoke.ts",
		"intent-service:lifecycle-smoke": "bun scripts/intent-service-lifecycle-smoke.ts",
		"artifact-processing:real-smoke": "bun scripts/artifact-processing-real-smoke.ts",
		"artifact-processing:real-pdf-smoke": "ARTIFACT_PROCESSING_REAL_FORMAT=pdf bun scripts/artifact-processing-real-smoke.ts",
		"artifact-processing:real-unsupported-smoke": "ARTIFACT_PROCESSING_REAL_FORMAT=unsupported bun scripts/artifact-processing-real-smoke.ts",
		"artifact-processing:vision-mock": "bun scripts/artifact-vision-mock-server.ts",
		"artifact-processing:vision-smoke": "bun scripts/artifact-processing-vision-smoke.ts",
		"artifact-processing:fixtures-e2e": "bun scripts/artifact-processing-fixtures-e2e.ts",
		"artifact-processing:failure-smoke": "ARTIFACT_PROCESSING_SMOKE_CASE=invalid bun scripts/artifact-processing-smoke.ts"
	},
	"dependencies": {
		"@avenos/artifact-store": "workspace:*",
		"@avenos/aven-hosting": "workspace:*",
		"@better-auth/passkey": "1.6.23",
		"@myavenceo/aven-ceo": "^0.9.0",
		"@polar-sh/sdk": "^0.49.0",
		"better-auth": "1.6.23",
		"dotenv": "17.3.1",
		"drizzle-orm": "0.45.2",
		"nodemailer": "9.0.3",
		"pg": "8.16.3",
		"pino": "10.3.1",
		"standardwebhooks": "^1.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@maizzle/framework": "6.1.0",
		"@maizzle/tailwindcss": "1.5.6",
		"@sveltejs/adapter-node": "^5.5.0",
		"@sveltejs/kit": "2.69.3",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@types/node": "24.10.13",
		"@types/nodemailer": "7.0.11",
		"@types/pg": "8.15.6",
		"drizzle-kit": "0.31.10",
		"shiki": "^4.4.3",
		"svelte": "5.56.5",
		"svelte-check": "4.4.6",
		"tailwind-merge": "^3.6.0",
		"typescript": "6.0.3",
		"vite": "8.1.4",
		"vitest": "4.1.10",
		"vue": "^3.5.41"
	}
}
