{
	on_demand_tls {
		ask http://static-site-host:8093/internal/caddy/ask
	}
}

# Exact identity origin. Its availability and health do not gate Caddy or the
# independently served customer sites below.
{$DOMAIN} {
	# Service-to-service control APIs are reachable only on the Compose network.
	header Strict-Transport-Security "max-age=31536000"
	respond /internal/* 404

	@artifact_upload {
		method PUT
		path /api/artifacts/files/*
	}
	handle @artifact_upload {
		request_body {
			max_size {$ARTIFACT_STORE_MAX_UPLOAD_BYTES:26214400}
		}
		reverse_proxy app:3000
	}
	handle {
		request_body {
			max_size 524288
		}
		reverse_proxy app:3000
	}
}

# Caddy obtains a certificate only after the host confirms that this exact
# customer domain has passed TXT and address verification.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	respond /internal/* 404
	reverse_proxy static-site-host:8093
}
