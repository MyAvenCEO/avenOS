<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match Mac App Store Connect provisioning profile (TestFlight error 90886 if missing). -->
	<key>com.apple.application-identifier</key>
	<string>2P6VCHVJWB.ceo.aven.os</string>
	<key>com.apple.developer.team-identifier</key>
	<string>2P6VCHVJWB</string>
	<key>keychain-access-groups</key>
	<array>
		<string>2P6VCHVJWB.*</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Microphone: voice notes are captured in the WebView (getUserMedia) and transcribed
	     on-device (Parakeet). Without this the sandbox blocks mic access and WKWebView won't
	     even expose navigator.mediaDevices. NSMicrophoneUsageDescription is in Info.plist. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Associated Domains: required for NATIVE passkeys (ASAuthorization / WebAuthn PRF) on macOS.
	     rp.id must be one of these hosts, each serving /.well-known/apple-app-site-association over
	     HTTPS. App ID ceo.aven.os has the Associated Domains capability enabled. board 0055. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:aven.ceo</string>
		<string>webcredentials:aven.ceo</string>
		<string>webcredentials:api.next.aven.ceo</string>
	</array>
</dict>
</plist>
