<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>AvenOS uses the microphone to record voice notes, which are transcribed on-device.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock your AvenOS device identity with Face ID or Touch ID.</string>
	<key>NSLocalNetworkUsageDescription</key>
