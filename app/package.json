{
	"name": "@AvenOS/app",
	"private": true,
	"version": "26.8.21-next.5",
	"type": "module",
	"scripts": {
		"predev": "bun ../scripts/free-dev-server-port.ts",
		"dev": "AVENOS_DEV_INSTANCE=A bun --env-file=${AVENOS_APP_ENV_FILE:-../.env} x --bun vite dev",
		"build": "bun --env-file=${AVENOS_APP_ENV_FILE:-../.env} x vite build",
		"preview": "bun --env-file=${AVENOS_APP_ENV_FILE:-../.env} x --bun vite preview",
		"prepare": "[ -e node_modules ] || ln -sf ../node_modules node_modules; bun --bun x svelte-kit sync || echo ''",
		"check": "bun --bun x svelte-kit sync && bun --bun x svelte-check --tsconfig ./tsconfig.json",
		"tauri": "bun --bun x tauri",
		"tauri:dev": "bun --bun x tauri dev",
		"tauri:ios:dev:sim": "bun --bun x tauri ios dev",
		"tauri:build:macos": "bun --bun x tauri build",
		"tauri:build:linux": "bun --bun x tauri build --bundles deb,appimage",
		"tauri:ios:build:asc": "bun ../scripts/tauri-ios-asc.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@tauri-apps/cli": "^2",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.13.9",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@avenos/aven-skills": "workspace:*",
		"@avenos/aven-ui": "workspace:*",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@xyflow/svelte": "^1.6.2",
		"quickjs-emscripten": "^0.31.0",
		"three": "^0.185.1"
	}
}
