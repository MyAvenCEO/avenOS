# App-local production build config (NON-SECRET). This sits in Vite's envDir (app/), so it's
# loaded directly into import.meta.env for `vite build` (production) — guaranteed, no reliance
# on process.env. `vite dev` ignores it, so local dev still uses the launcher's localhost URL.
# Points production builds at the deployed next auth API so sign-in works in shipped apps.
PUBLIC_BETTER_AUTH_URL=https://api.next.aven.ceo
