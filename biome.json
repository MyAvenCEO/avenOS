{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!**/bun.lock",
			"!!.claude",
			"!!**/permissions/schemas",
			"!!app/src-tauri/gen",
			"// ARCHIVE is parked reference source (card 0121). It is deliberately",
			"// outside the workspaces and is not maintained, so linting it only",
			"// produces noise about code nobody is editing.",
			"!!ARCHIVE",
			"// SVGs here are design assets (the app icon and the logo), not markup we",
			"// author. a11y rules want a <title> in them, which would mean editing the",
			"// artwork to satisfy a linter.",
			"!!**/*.svg",
			"// Emscripten glue shipped beside its .wasm — vendored build output that",
			"// happens to live under static/, not source anyone edits here.",
			"!!app/static/webcm"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"trailingCommas": "none"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"lineWidth": 100
		},
		"linter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedFunctionParameters": "off"
					},
					"suspicious": {
						"noGlobalAssign": "off"
					},
					"a11y": "off"
				}
			}
		},
		{
			"includes": ["scripts/tauri-ios-asc.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noTemplateCurlyInString": "off"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
