{
	email {$ACME_EMAIL:ops@aven.ceo}
	admin off
	on_demand_tls {
		ask http://static-site-host:8093/internal/caddy/ask
	}
}

{$API_DOMAIN:api.aven.ceo} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	request_body {
		max_size 160MiB
	}
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

{$CHECKOUT_DOMAIN:portal.aven.ceo} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	request_body {
		max_size 1MiB
	}
	reverse_proxy checkout:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy static-site-host:8093
}
