{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["bun", "node"],
		"typeRoots": ["../../services/aven-api/node_modules/@types"]
	},
	"include": [
		"platform.spec.ts",
		"portal-layout.spec.ts",
		"pdf-render.ts",
		"live-context-boundaries.ts",
		"live-admission-feedback.ts",
		"live-conversation-capacity.ts",
		"live-answer-opening.ts",
		"live-tool-selection.ts",
		"live-case-qualification.ts",
		"live-growing-conversation.ts",
		"live-intent-references.ts",
		"live-receipt-review-options.ts",
		"live-case-review.ts",
		"live-dispatched-chat.ts",
		"live-background-chat.ts",
		"live-long-durable-conversation.ts",
		"live-http-conversation.ts",
		"live-credential-envelope.ts",
		"live-credential-proxy.ts",
		"live-imap-proxy.ts",
		"live-connection-skills.ts",
		"live-native-connections.ts",
		"prepare-connection-stack.ts",
		"credential-backup-proof.ts",
		"live-intent-conflict-recovery.ts",
		"artifact-store-memory.ts",
		"artifact-store-pools.ts"
