{
	email {$ACME_EMAIL:ops@aven.ceo}
	admin off
}

{$IDENTITY_DOMAIN:aven.id} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@untrusted_internal {
		path /internal/*
		not remote_ip {$IDENTITY_PLATFORM_IPS}
	}
	respond @untrusted_internal 404
	request_body {
		max_size 128KiB
	}
	reverse_proxy identity:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}
