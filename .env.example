# Optional waitlist webhook (Slack-compatible JSON). When unset, submissions log to the server console.
# WAITLIST_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Tinfoil private AI inference. Powers the authenticated proxy on the auth server
# (POST /api/ai/chat — only signed-in users can run inference; the key never leaves the
# server). Also used by the on-device/native Aven endpoints. Optional overrides:
# TINFOIL_BASE_URL (default https://inference.tinfoil.sh/v1), TINFOIL_MODEL (default gemma4-31b).
TINFOIL_API_KEY=

# Optional. Vault-owner note basename only — must match OWNER_*.md (e.g. OWNER_jamie.md). File lives under Humans/ in the vault.
AVEN_VAULT_OWNER_HUMANS_FILE="OWNER_your-name"

GOOGLE_API_KEY=

# Self-hosted Better Auth server for the mainnet/alberobello Google sign-in (libs/betterauth).
# Run with `bun run dev:auth`. board 0050.
NEON_PG_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:8787"                 # auth server origin (server-side)
PUBLIC_BETTER_AUTH_URL="http://localhost:8787"          # same value, exposed to the SvelteKit client
# Use a Google "Desktop app" OAuth client (NOT a "Web application" client): its secret is
# non-confidential (PKCE/loopback), so it is safe inside the Tauri app, and Google auto-allows
# the loopback redirect (http://localhost:<random-port>) the native sign-in plugin uses — no
# redirect URI to register. Better Auth verifies the idToken audience against this same id, and
# the desktop process reads the secret via the `google_oauth_config` Tauri command (never bundled
# into the web build). (A separate "Web application" client + {BETTER_AUTH_URL}/api/auth/callback/google
# is only needed if you also want browser/dev redirect sign-in.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Polar billing (Better Auth polar plugin + checkout/webhook). A Polar customer is created
# per user on sign-up (external_id = our user id); the Plan tab books avenCITY via the SDK
# and a webhook syncs the active subscription → the user's `tier`. Optional: when
# POLAR_API_KEY is unset the plugin/checkout are disabled and the server still boots.
POLAR_API_KEY=
POLAR_SERVER=
# Webhook secret from the Polar dashboard endpoint (Settings → Webhooks). Point the endpoint
# at {BETTER_AUTH_URL}/api/billing/webhook with format RAW. Required for tier sync.
POLAR_WEBHOOK_SECRET=
# Paid-tier product ids. Configure these per environment.
# avenME = 7€/wk (35 MINDS), avenFOUNDER = 34€/wk (170 MINDS), avenCEO = 377€/wk (1885 MINDS).
# MINDS = price € × 5 (credits.ts). Add a new tier with one row in billing.ts TIERS + credits.ts.
POLAR_AVENME_PRODUCT_ID=
POLAR_AVENFOUNDER_PRODUCT_ID=
POLAR_AVENCEO_PRODUCT_ID=
# Optional: where Polar redirects after a successful checkout. Defaults to {BETTER_AUTH_URL}/billing/success.
# POLAR_CHECKOUT_SUCCESS_URL="https://app.example.com/?upgraded=1"

# Vibe sandbox (`bun dev:app`): listen port — `VIBE_SANDBOX_PORT` preferred, else `PORT`, default 8081 (dev retries 8081–8086 if both unset).
# app defaults to http://localhost:8081/sandbox.html — when you change the port, set this so the iframe matches:
# VIBE_SANDBOX_PORT=8082
# PUBLIC_VIBE_SANDBOX_URL="http://localhost:8082/sandbox.html"
