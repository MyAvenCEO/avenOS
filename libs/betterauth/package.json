{
	"name": "@avenos/betterauth",
	"private": true,
	"version": "26.6.1-next.17",
	"type": "module",
	"description": "Self-hosted Better Auth server (bun + Hono) on Neon Postgres via the kysely-neon dialect. Google sign-in for the mainnet/alberobello app.",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/server.ts",
		"start": "bun run src/server.ts",
		"db:generate": "bunx @better-auth/cli@latest generate --config src/auth.ts -y",
		"db:migrate": "bunx @better-auth/cli@latest migrate --config src/auth.ts -y",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@neondatabase/serverless": "^0.10.4",
		"better-auth": "^1.4.18",
		"hono": "^4.6.14",
		"kysely": "^0.27.5",
		"kysely-neon": "^1.3.0"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.18",
		"typescript": "^5.7.2"
	}
}
