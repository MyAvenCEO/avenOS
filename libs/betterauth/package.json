{
	"name": "@avenos/betterauth",
	"private": true,
	"version": "26.7.16-next.6",
	"type": "module",
	"description": "Self-hosted Better Auth server (bun + Hono) on Neon Postgres via the kysely-neon dialect. Google sign-in + Polar account link for the mainnet/alberobello app. Runnable standalone from this folder.",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "bun --env-file=../../.env --watch src/server.ts",
		"start": "bun --env-file=../../.env src/server.ts",
		"db:generate": "bash -c 'set -a; . ../../.env; set +a; bunx @better-auth/cli@latest generate --config src/auth.ts -y'",
		"db:migrate": "bash -c 'set -a; . ../../.env; set +a; bunx @better-auth/cli@latest migrate --config src/auth.ts -y'",
		"db:migrate:usage": "bun --env-file=../../.env src/migrate.ts",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "bun test tests"
	},
	"dependencies": {
		"@avenos/aven-ontology": "workspace:*",
		"@avenos/aven-skills": "workspace:*",
		"@avenos/aven-vibes": "workspace:*",
		"@avenos/skills": "workspace:*",
		"@better-auth/passkey": "^1.6.20",
		"@neondatabase/serverless": "^0.10.4",
		"@polar-sh/better-auth": "^1.8.4",
		"@polar-sh/sdk": "^0.48.1",
		"ajv": "^8.20.0",
		"better-auth": "^1.4.18",
		"hono": "^4.6.14",
		"kysely": "^0.27.5",
		"kysely-neon": "^1.3.0",
		"quickjs-emscripten": "^0.32.0"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.18",
		"typescript": "^5.7.2"
	}
}
