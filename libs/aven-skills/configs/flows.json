[
	{
		"id": "ingest",
		"name": "Dokument-Ingest",
		"description": "Wiederverwendbarer Skill: rohe Datei → importieren → ablegen → klassifizieren → je nach Belegart extrahieren. Liefert ein strukturiertes Dokument (Rechnung | Transaktionen | Vertrag).",
		"nodes": [
			{
				"id": "import",
				"name": "Importieren",
				"actor": "importDocument",
				"inputs": ["file", "image"],
				"outputs": ["document"],
				"note": "Datei / Foto / Scan übernehmen",
				"tools": ["upload"],
				"supervision": {
					"strategy": "resume"
				}
			},
			{
				"id": "store",
				"name": "Ablegen",
				"actor": "sparkWriteBytes",
				"inputs": ["document"],
				"outputs": ["document"],
				"note": "Inhaltsadressiert in sparks/PRIVATE/<sha256>",
				"tools": ["sparkWriteBytes"],
				"supervision": {
					"strategy": "resume"
				}
			},
			{
				"id": "classify",
				"name": "Klassifizieren",
				"actor": "classify_document",
				"inputs": ["document"],
				"outputs": ["document"],
				"note": "Belegart erkennen → entscheidet die Verzweigung",
				"system_prompt": "Du bist Buchhalter. Bestimme die Belegart: invoice (Rechnung), bank_statement (Kontoauszug), contract (Vertrag) oder other. Gib Titel, Tags und eine kurze Buchungs-Zusammenfassung zurück.",
				"llm": {
					"model": "gemma4-31b",
					"vision": true,
					"mode": "vision"
				},
				"tools": ["classify_document"],
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			},
			{
				"id": "extract-invoice",
				"name": "Rechnung extrahieren",
				"flowRef": "rechnung",
				"inputs": ["document"],
				"outputs": ["invoice"],
				"note": "Composite → Sub-Skill »Rechnung extrahieren«",
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			},
			{
				"id": "bank",
				"name": "Kontoauszug",
				"flowRef": "bank-statement",
				"inputs": ["document"],
				"outputs": ["transaction", "contact"],
				"note": "Composite → Sub-Skill »Kontoauszug« (extrahieren + Transaktionen anlegen)",
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			},
			{
				"id": "extract-contract",
				"name": "Vertrag extrahieren",
				"flowRef": "vertrag",
				"inputs": ["document"],
				"outputs": ["contract"],
				"note": "Composite → Sub-Skill »Vertrag extrahieren«",
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			}
		],
		"edges": [
			{
				"from": "import",
				"to": "store",
				"resource": "document",
				"kind": "data",
				"message": "document"
			},
			{
				"from": "store",
				"to": "classify",
				"resource": "document",
				"kind": "data",
				"message": "document"
			},
			{
				"from": "classify",
				"to": "extract-invoice",
				"resource": "document",
				"kind": "data",
				"message": "document",
				"when": "Rechnung"
			},
			{
				"from": "classify",
				"to": "bank",
				"resource": "document",
				"kind": "data",
				"message": "document",
				"when": "Kontoauszug"
			},
			{
				"from": "classify",
				"to": "extract-contract",
				"resource": "document",
				"kind": "data",
				"message": "document",
				"when": "Vertrag"
			}
		],
		"triggers": [
			{
				"kind": "resource",
				"on": "file"
			},
			{
				"kind": "resource",
				"on": "image"
			}
		]
	},
	{
		"id": "rechnung",
		"name": "Rechnung extrahieren",
		"description": "Wiederverwendbarer Extraktions-Skill: Dokument → invoice-JSON (striktes Schema).",
		"nodes": [
			{
				"id": "extract",
				"name": "Rechnung extrahieren",
				"actor": "extract_document",
				"inputs": ["document"],
				"outputs": ["invoice"],
				"system_prompt": "Extrahiere alle Felder der Rechnung (Kopf, Lieferant, Käufer, Positionen, Summen) als striktes JSON nach dem invoice-Schema.",
				"llm": {
					"model": "gemma4-31b",
					"vision": true,
					"mode": "tool"
				},
				"tools": ["extract_document", "emit_fields"],
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			}
		],
		"edges": [],
		"triggers": [
			{
				"kind": "resource",
				"on": "document"
			}
		]
	},
	{
		"id": "vertrag",
		"name": "Vertrag extrahieren",
		"description": "Wiederverwendbarer Extraktions-Skill: Dokument → contract-JSON (striktes Schema).",
		"nodes": [
			{
				"id": "extract",
				"name": "Vertrag extrahieren",
				"actor": "extract_document",
				"inputs": ["document"],
				"outputs": ["contract"],
				"system_prompt": "Extrahiere Vertragsparteien, Laufzeit, Kündigungsfrist und Konditionen als JSON nach dem contract-Schema.",
				"llm": {
					"model": "gemma4-31b",
					"vision": true,
					"mode": "tool"
				},
				"tools": ["extract_document", "emit_fields"],
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			}
		],
		"edges": [],
		"triggers": [
			{
				"kind": "resource",
				"on": "document"
			}
		]
	},
	{
		"id": "doc-ingest",
		"name": "Beleg-Ingest",
		"description": "Buchhaltungs-Flow: nutzt den Dokument-Ingest-Skill → Adressbuch anreichern → als offenen Posten buchen. Zahlung folgt via »Offene Posten ausgleichen«.",
		"nodes": [
			{
				"id": "ingest",
				"name": "Beleg verstehen",
				"flowRef": "ingest",
				"inputs": ["file", "image"],
				"outputs": ["invoice", "transaction", "contact", "contract"],
				"note": "Composite → Skill »Dokument-Ingest« (Import→Ablage→Klassifizieren→Extrahieren)",
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			},
			{
				"id": "enrich",
				"name": "Adressbuch anreichern",
				"actor": "enrichAddressbookFromDoc",
				"inputs": ["invoice", "contract"],
				"outputs": ["contact"],
				"note": "Parteien matchen (USt-IdNr/IBAN/Name) → anlegen/ergänzen",
				"tools": ["matchContact", "data_crud"],
				"supervision": {
					"strategy": "resume"
				}
			},
			{
				"id": "book-open",
				"name": "Als offen buchen (SKR04)",
				"actor": "bookInvoiceOpen",
				"inputs": ["invoice"],
				"outputs": ["open_item"],
				"note": "Sollstellung: Aufwand/Erlös + Vorsteuer/USt → Forderung/Verbindlichkeit als OFFEN. Zahlung folgt via »Offene Posten ausgleichen«.",
				"system_prompt": "Buche die Rechnung in SKR04 als offenen Posten (Sollstellung): pro Position das beste Konto (NETTO) + tax_treatment; das System bucht Vorsteuer/USt. Status = offen, wartet auf die Zahlung.",
				"llm": {
					"model": "gemma4-31b",
					"mode": "tool"
				},
				"tools": ["book_invoice"],
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			}
		],
		"edges": [
			{
				"from": "ingest",
				"to": "enrich",
				"resource": "invoice",
				"kind": "data",
				"message": "invoice"
			},
			{
				"from": "ingest",
				"to": "enrich",
				"resource": "contract",
				"kind": "data",
				"message": "contract"
			},
			{
				"from": "ingest",
				"to": "book-open",
				"resource": "invoice",
				"kind": "data",
				"message": "invoice"
			}
		],
		"triggers": [
			{
				"kind": "resource",
				"on": "document"
			},
			{
				"kind": "resource",
				"on": "image"
			}
		]
	},
	{
		"id": "outgoing-invoice",
		"name": "Ausgangsrechnung",
		"description": "Per Prompt erstellen → Nummer + USt → PDF → als Erlös buchen.",
		"nodes": [
			{
				"id": "create",
				"name": "Rechnung erstellen",
				"actor": "create_invoice",
				"inputs": ["prompt"],
				"outputs": ["invoice"],
				"note": "Kunde + Positionen aus dem Prompt",
				"system_prompt": "Erstelle eine Ausgangsrechnung: Kunde auflösen/anlegen, Positionen (NETTO + tax_treatment). Der Server vergibt die fortlaufende Nummer und rechnet die USt.",
				"llm": {
					"model": "gemma4-31b",
					"mode": "tool"
				},
				"tools": ["create_invoice"],
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			},
			{
				"id": "number",
				"name": "Nummer + USt",
				"actor": "assignInvoiceNumber",
				"inputs": ["invoice"],
				"outputs": ["invoice"],
				"note": "R-ID-0001, VAT auto",
				"supervision": {
					"strategy": "resume"
				}
			},
			{
				"id": "pdf",
				"name": "PDF speichern",
				"actor": "saveInvoicePdf",
				"inputs": ["invoice"],
				"outputs": ["pdf"],
				"note": "§14-konform, in PRIVATE store",
				"supervision": {
					"strategy": "resume"
				}
			},
			{
				"id": "book-out",
				"name": "Erlös buchen",
				"actor": "buildOutgoingBooking",
				"inputs": ["invoice"],
				"outputs": ["booking"],
				"note": "Erlös 4400/4300 → Forderung 1200",
				"supervision": {
					"strategy": "resume"
				}
			}
		],
		"edges": [
			{
				"from": "create",
				"to": "number",
				"resource": "invoice",
				"kind": "data",
				"message": "invoice"
			},
			{
				"from": "number",
				"to": "pdf",
				"resource": "invoice",
				"kind": "data",
				"message": "invoice"
			},
			{
				"from": "number",
				"to": "book-out",
				"resource": "invoice",
				"kind": "data",
				"message": "invoice"
			}
		],
		"triggers": [
			{
				"kind": "manual"
			}
		]
	},
	{
		"id": "bank-statement",
		"name": "Kontoauszug",
		"description": "Kontoauszug extrahieren → Transaktionen + Kontoinhaber herausfächern und idempotent anlegen.",
		"nodes": [
			{
				"id": "extract-stmt",
				"name": "Auszug extrahieren",
				"actor": "extractDocFields",
				"inputs": ["bank_statement"],
				"outputs": ["transaction", "contact"],
				"note": "Fan-out 1→N",
				"system_prompt": "Extrahiere Kontoinhaber, Saldo und jede Transaktion als JSON nach dem bank_statement-Schema.",
				"llm": {
					"model": "gemma4-31b",
					"vision": true,
					"mode": "tool"
				},
				"tools": ["extract_document", "emit_fields"],
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			},
			{
				"id": "fanout",
				"name": "Transaktionen anlegen",
				"actor": "fanOutTransactions",
				"inputs": ["transaction"],
				"outputs": ["transaction"],
				"note": "idempotent (dedup_key)",
				"tools": ["data_crud"],
				"supervision": {
					"strategy": "resume"
				}
			}
		],
		"edges": [
			{
				"from": "extract-stmt",
				"to": "fanout",
				"resource": "transaction",
				"kind": "data",
				"message": "transaction"
			}
		],
		"triggers": [
			{
				"kind": "resource",
				"on": "bank_statement"
			}
		]
	},
	{
		"id": "open-item-match",
		"name": "Offene Posten ausgleichen",
		"description": "Event-getriggert bei Zahlungseingang: eine Transaktion sucht ihren offenen Posten → ausgleichen (bezahlt) oder, ohne Beleg, parken (wartet auf Beleg). Deckt beide Zeitrichtungen ab (Beleg-zuerst und Transaktion-zuerst).",
		"nodes": [
			{
				"id": "find-open",
				"name": "Offenen Posten suchen",
				"actor": "findOpenItem",
				"inputs": ["transaction"],
				"outputs": ["open_item", "transaction"],
				"note": "Match per Betrag / Gegenpartei / IBAN / Datum",
				"system_prompt": "Finde den offenen Posten, den diese Transaktion ausgleicht (Betrag, Cross-Currency, Gegenpartei, Datum) — oder keinen.",
				"llm": {
					"model": "gemma4-31b",
					"mode": "tool"
				},
				"tools": ["pick_match"],
				"supervision": {
					"strategy": "restart",
					"retry": {
						"max": 2,
						"backoff": "exponential"
					}
				}
			},
			{
				"id": "settle",
				"name": "Ausgleichen (Zahlung)",
				"actor": "settleOpenItem",
				"inputs": ["open_item", "transaction"],
				"outputs": ["booking"],
				"note": "Fan-in: offener Posten + Zahlung → Zahlungsbuchung, Status → bezahlt",
				"tools": ["book_invoice", "data_crud"],
				"supervision": {
					"strategy": "resume"
				}
			},
			{
				"id": "park",
				"name": "Parken (kein Beleg)",
				"actor": "parkTransaction",
				"inputs": ["transaction"],
				"outputs": ["transaction"],
				"note": "Dead-letter: Transaktion ohne Beleg → wartet auf Beleg",
				"tools": ["data_crud"],
				"supervision": {
					"strategy": "resume"
				}
			}
		],
		"edges": [
			{
				"from": "find-open",
				"to": "settle",
				"resource": "open_item",
				"when": "Treffer",
				"kind": "data",
				"message": "open_item"
			},
			{
				"from": "find-open",
				"to": "park",
				"resource": "transaction",
				"when": "kein Beleg",
				"kind": "data",
				"message": "transaction"
			}
		],
		"triggers": [
			{
				"kind": "event",
				"on": "transaction"
			}
		]
	},
	{
		"id": "tx-import",
		"name": "Kontobewegungen importieren",
		"description": "Bankauszug / CSV → die aven-skills Ingestor-Pipeline (ingest → parse → transform → dedup → assemble): Transaktionen mit Provenance, idempotent. Eigenständiger Eingang, unabhängig von einem Beleg.",
		"nodes": [
			{
				"id": "ingest-csv",
				"name": "Datei aufnehmen",
				"actor": "ingest",
				"inputs": ["file"],
				"outputs": ["bank_statement"],
				"note": "Inhalt hashen + ablegen (UploaderPort); Doppel-Import = No-op",
				"tools": ["data_crud"],
				"supervision": {
					"strategy": "resume"
				}
			},
			{
				"id": "parse-csv",
				"name": "CSV parsen",
				"actor": "parse",
				"inputs": ["bank_statement"],
				"outputs": ["transaction"],
				"note": "Spalten + Zeilen dekodieren (rowRef Provenance)",
				"supervision": {
					"strategy": "resume"
				}
			},
			{
				"id": "transform",
				"name": "Auf Schema mappen",
				"actor": "transform",
				"inputs": ["transaction"],
				"outputs": ["transaction"],
				"note": "Feld-Mapping per IngestConfig (bank-statement-tx.json) → transactions",
				"supervision": {
					"strategy": "resume"
				}
			},
			{
				"id": "dedup",
				"name": "Dedupe + Ablage",
				"actor": "dedup",
				"inputs": ["transaction"],
				"outputs": ["transaction"],
				"note": "Idempotent per key; _source Provenance je Zeile",
				"tools": ["data_crud"],
				"supervision": {
					"strategy": "resume"
				}
			}
		],
		"edges": [
			{
				"from": "ingest-csv",
				"to": "parse-csv",
				"resource": "bank_statement",
				"kind": "data",
				"message": "bank_statement"
			},
			{
				"from": "parse-csv",
				"to": "transform",
				"resource": "transaction",
				"kind": "data",
				"message": "transaction"
			},
			{
				"from": "transform",
				"to": "dedup",
				"resource": "transaction",
				"kind": "data",
				"message": "transaction"
			}
		],
		"triggers": [
			{
				"kind": "resource",
				"on": "file"
			}
		]
	},
	{
