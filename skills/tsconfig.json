{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true
	},
	"include": [
		"index.ts",
		"composer/index.ts",
		"composer/site-generator.ts",
		"composer/edit.ts",
		"composer/authoring.ts",
		"composer/tools.ts"
	]
}
