{
	"name": "avenos",
	"private": true,
	"type": "module",
	"workspaces": [
		"libs/*",
		"app",
		"services/*",
		"infrastructure/*"
	],
	"scripts": {
		"dev:app": "bun --env-file=.env run --cwd app dev",
		"dev:api": "bun --env-file=.env run --cwd services/aven-api dev",
		"dev:identity": "bun --env-file=.env run --cwd services/identity dev",
		"dev:checkout": "bun --env-file=.env run --cwd services/checkout dev",
		"dev:app:all": "bun --env-file=.env ./scripts/dev-app-all.ts",
		"dev:app:mac": "bun ./scripts/dev-app-macos.ts",
		"dev:app:ios": "bun --env-file=.env ./scripts/dev-app-ios.ts",
		"dev:app:android": "bun --env-file=.env ./scripts/build-app-android.ts --dev",
		"dev:app:linux": "bun ./scripts/dev-app-linux.ts",
		"dev:app2x:mac": "bun --env-file=.env ./scripts/dev-two-instances.ts",
		"dev:app2x:linux": "bun --env-file=.env ./scripts/dev-two-instances.ts",
		"clean:app:rust": "bun ./scripts/clean-app-tauri-target.ts",
		"gc:rust": "bash ./scripts/gc-rust-target.sh",
		"build:app:mac": "AVENOS_ENV_FILE=.env.samuel AVENOS_APP_ENV_FILE=../.env.samuel bun --env-file=.env.samuel ./scripts/build-appstore-macos.ts",
		"build:app:linux": "AVENOS_ENV_FILE=.env.daniel AVENOS_APP_ENV_FILE=../.env.daniel bun --env-file=.env.daniel ./scripts/build-app-linux.ts",
		"build:app:android": "bun --env-file=.env ./scripts/build-app-android.ts",
		"release:app:all": "bun ./scripts/release-app.ts all",
		"release:app:mac": "AVENOS_ENV_FILE=.env.samuel AVENOS_APP_ENV_FILE=../.env.samuel bun --env-file=.env.samuel ./scripts/release-app.ts mac",
		"release:app:ios": "bun ./scripts/release-app.ts ios",
		"icons": "bun ./scripts/generate-app-icons.ts",
		"next-version": "bun ./scripts/next-version.ts",
		"set-version": "bun ./scripts/set-version.ts",
		"changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
		"release:next": "bun ./scripts/release-next.ts",
		"check": "bun run --cwd app check",
		"build:api": "bun run --cwd services/aven-api build",
		"build:identity": "bun run --cwd services/identity build",
		"build:checkout": "bun run --cwd services/checkout build",
		"check:api": "bun run --cwd services/aven-api check",
		"check:identity": "bun run --cwd services/identity check",
		"check:checkout": "bun run --cwd services/checkout check",
		"check:customer-platform": "bun run --cwd libs/aven-customer-contracts check && bun run --cwd libs/aven-customer-runtime check && bun run --cwd libs/aven-actors check && bun run --cwd libs/aven-http-resources check && bun run --cwd services/platform-provisioner check && bun run --cwd services/intent-service check && bun run --cwd services/actor-runner check",
		"check:docs": "bun ./scripts/check-doc-links.ts && bun ./scripts/check-doc-policy.ts",
		"check:runner": "bun run --cwd services/actor-runner check",
		"test:api": "bun run --cwd services/aven-api test",
		"test:identity": "bun run --cwd services/identity test",
		"test:checkout": "bun run --cwd services/checkout test",
		"test:customer-platform": "bun run --cwd libs/aven-customer-contracts test && bun run --cwd libs/aven-customer-runtime test && bun run --cwd libs/aven-actors test && bun run --cwd libs/aven-http-resources test && bun run --cwd services/platform-provisioner test && bun run --cwd services/intent-service test && bun run --cwd services/actor-runner test",
		"test:runner": "bun run --cwd services/actor-runner test",
		"build:runner": "bun run --cwd services/actor-runner build",
		"email:studio": "bun run --cwd services/checkout email:studio",
		"email:preview": "bun run --cwd services/checkout email:preview",
		"email:compile": "bun run --cwd services/checkout email:compile",
		"email:check": "bun run --cwd services/checkout email:check",
		"test:infra": "bun run --cwd infrastructure/platform test",
		"test:bootstrap": "bun run --cwd infrastructure/bootstrap test",
		"bootstrap:deployment:guided": "bun ./scripts/deployment-bootstrap-guided.ts",
		"bootstrap:deployment": "bun ./scripts/deployment-bootstrap.ts",
		"models:redpill-phala": "bun ./scripts/redpill-model-catalog.ts",
		"test:deploy": "bash deploy/validate.sh",
		"test:recovery": "bash deploy/operations/test-recovery.sh",
		"test:e2e:platform": "bash deploy/e2e/run.sh",
		"local:up": "bash deploy/local/up.sh",
		"local:down": "bash deploy/local/down.sh",
		"local:account": "bash deploy/local/account.sh",
		"local:app": "bash deploy/local/app.sh",
		"db:migrate:identity": "bun run --cwd services/identity db:migrate",
		"db:migrate:checkout": "bun run --cwd services/checkout db:migrate",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check --write .",
		"format": "bunx biome format --write .",
		"brand:generate": "bun ./scripts/generate-brand.ts",
		"design:render": "bun ./scripts/render-design-system.ts"
	},
	"devDependencies": {
		"@avenos/aven-ui": "workspace:*",
		"@biomejs/biome": "^2.4.14",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@myavenceo/aven-ceo": "^0.9.0",
		"@myavenceo/aven-vibes": "^0.2.1",
		"@playwright/test": "^1.62.1",
		"@polar-sh/sdk": "0.49.0",
		"@types/pg": "8.15.6",
		"@types/terminal-kit": "2.5.7",
		"conventional-changelog-cli": "^5.0.0",
		"pg": "8.16.3",
		"semver": "^7.8.4",
		"sharp": "^0.35.3",
		"terminal-kit": "3.1.4"
	}
}
