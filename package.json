{
	"name": "avenos",
	"private": true,
	"type": "module",
	"workspaces": [
		"libs/*",
		"app",
		"services/*",
		"infrastructure/*"
	],
	"scripts": {
		"dev:app": "bun --env-file=.env run --cwd app dev",
		"dev:api": "bun --env-file=.env run --cwd services/aven-api dev",
		"dev:api:artifacts": "docker compose -f services/aven-api/docker-compose.yml -f services/aven-api/docker-compose.artifact-store.yml up --build",
		"dev:api:designer": "bun run --cwd services/aven-api dev:designer",
		"dev:app:all": "bun --env-file=.env ./scripts/dev-app-all.ts",
		"dev:app:mac": "AVENOS_ENV_FILE=.env.samuel AVENOS_APP_ENV_FILE=../.env.samuel bun --env-file=.env.samuel ./scripts/dev-app-macos.ts",
		"dev:app:ios": "bun --env-file=.env ./scripts/dev-app-ios.ts",
		"dev:app:linux": "AVENOS_ENV_FILE=.env.daniel AVENOS_APP_ENV_FILE=../.env.daniel bun --env-file=.env.daniel ./scripts/dev-app-linux.ts",
		"dev:app2x:mac": "bun --env-file=.env ./scripts/dev-two-instances.ts",
		"dev:app2x:linux": "bun --env-file=.env ./scripts/dev-two-instances.ts",
		"clean:app:rust": "bun ./scripts/clean-app-tauri-target.ts",
		"gc:rust": "bash ./scripts/gc-rust-target.sh",
		"build:app:mac": "AVENOS_ENV_FILE=.env.samuel AVENOS_APP_ENV_FILE=../.env.samuel bun --env-file=.env.samuel ./scripts/build-appstore-macos.ts",
		"build:app:linux": "AVENOS_ENV_FILE=.env.daniel AVENOS_APP_ENV_FILE=../.env.daniel bun --env-file=.env.daniel ./scripts/build-app-linux.ts",
		"release:app:all": "bun ./scripts/release-app.ts all",
		"release:app:mac": "AVENOS_ENV_FILE=.env.samuel AVENOS_APP_ENV_FILE=../.env.samuel bun --env-file=.env.samuel ./scripts/release-app.ts mac",
		"release:app:ios": "bun ./scripts/release-app.ts ios",
		"icons": "bun ./scripts/generate-app-icons.ts",
		"next-version": "bun ./scripts/next-version.ts",
		"set-version": "bun ./scripts/set-version.ts",
		"changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
		"release:next": "bun ./scripts/release-next.ts",
		"check": "bun run --cwd app check",
		"build:api": "bun run --cwd services/aven-api build",
		"build:api:designer": "bun run --cwd services/aven-api build:designer",
		"check:api": "bun run --cwd services/aven-api check",
		"test:api": "bun run --cwd services/aven-api test",
		"test:artifact-store:smoke": "bun run --cwd services/aven-api artifact-store:smoke",
		"test:artifact-processing:smoke": "bun run --cwd services/aven-api artifact-processing:smoke",
		"test:persistent-intent:smoke": "bun run --cwd services/aven-api persistent-intent:smoke",
		"test:intent-service:lifecycle": "bun run --cwd services/aven-api intent-service:lifecycle-smoke",
		"test:artifact-processing:real-smoke": "bun run --cwd services/aven-api artifact-processing:real-smoke",
		"test:artifact-processing:real-pdf-smoke": "bun run --cwd services/aven-api artifact-processing:real-pdf-smoke",
		"test:artifact-processing:real-unsupported-smoke": "bun run --cwd services/aven-api artifact-processing:real-unsupported-smoke",
		"test:artifact-processing:failure-smoke": "bun run --cwd services/aven-api artifact-processing:failure-smoke",
		"test:artifact-processing:vision-smoke": "bun run --cwd services/aven-api artifact-processing:vision-smoke",
		"test:artifact-processing:fixtures-e2e": "bun run --cwd services/aven-api artifact-processing:fixtures-e2e",
		"email:studio": "bun run --cwd services/aven-api email:studio",
		"email:preview": "bun run --cwd services/aven-api email:preview",
		"email:compile": "bun run --cwd services/aven-api email:compile",
		"email:check": "bun run --cwd services/aven-api email:check",
		"test:infra": "bun run --cwd infrastructure/identity test",
		"db:migrate:api": "bun run --cwd services/aven-api db:migrate",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check --write .",
		"format": "bunx biome format --write .",
		"brand:generate": "bun ./scripts/generate-brand.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"conventional-changelog-cli": "^5.0.0",
		"semver": "^7.8.4",
		"sharp": "^0.35.3"
	}
}
